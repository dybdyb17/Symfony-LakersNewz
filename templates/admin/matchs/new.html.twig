{% extends 'base.html.twig' %}
{% block title %}Admin - Nouveau match{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body_class %}admin-page{% endblock %}
{% block body %}
<main class="admin-main admin-main--narrow">
    <h1 class="admin-title">Créer un match</h1>

    <div class="admin-form-card">
        {{ form_start(form, {'attr': {'class': 'admin-form'}}) }}
            <div>
                {{ form_label(form.team1) }}
                {{ form_widget(form.team1) }}
            </div>
            <div>
                {{ form_label(form.team2) }}
                {{ form_widget(form.team2) }}
            </div>
            <div class="form-row">
                <div>
                    {{ form_label(form.cote1) }}
                    {{ form_widget(form.cote1) }}
                </div>
                <div>
                    {{ form_label(form.cote2) }}
                    {{ form_widget(form.cote2) }}
                </div>
            </div>
            <div>
                {{ form_label(form.dateMatch) }}
                {{ form_widget(form.dateMatch) }}
            </div>
            <button type="submit" class="admin-btn-submit">Créer le match</button>
        {{ form_end(form) }}
    </div>

    <a href="{{ path('admin_matchs_index') }}" class="admin-back-link">← Retour à la liste</a>
</main>
{% endblock %}
