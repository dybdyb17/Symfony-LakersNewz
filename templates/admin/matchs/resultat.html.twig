{% extends 'base.html.twig' %}
{% block title %}Admin - Résultat du match{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body_class %}admin-page{% endblock %}
{% block body %}
<main class="admin-main admin-main--narrow">
    <h1 class="admin-title">Résultat du match</h1>

    <div class="admin-resultat-box">
        <p class="admin-resultat-team">{{ match.team1 }}</p>
        <p class="admin-resultat-vs">VS</p>
        <p class="admin-resultat-team">{{ match.team2 }}</p>

        <form method="post" action="{{ path('admin_matchs_resultat', {id: match.id}) }}" class="admin-form">
            <div class="admin-score-row">
                <div>
                    <span class="admin-score-label">Score {{ match.team1 }}</span>
                    <input type="number" name="scoreTeam1" value="0" min="0" class="admin-score-input">
                </div>
                <div>
                    <span class="admin-score-label">Score {{ match.team2 }}</span>
                    <input type="number" name="scoreTeam2" value="0" min="0" class="admin-score-input">
                </div>
            </div>
            <button type="submit" class="admin-btn-submit">Valider le résultat</button>
        </form>
    </div>

    <a href="{{ path('admin_matchs_index') }}" class="admin-back-link">← Retour à la liste</a>
</main>
{% endblock %}
