{% extends 'base.html.twig' %}
{% block title %}Admin - Résultat du match{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body_class %}admin{% endblock %}
{% block body %}
<main class="admin-page admin-page-petite">
    <h1 class="admin-title">Résultat du match</h1>

    <div class="admin-resultat-conteneur">
        <p class="admin-resultat-equipe">{{ match.team1 }}</p>
        <p class="admin-resultat-vs">VS</p>
        <p class="admin-resultat-equipe">{{ match.team2 }}</p>

        <form method="post" action="{{ path('admin_matchs_resultat', {id: match.id}) }}" class="admin-formulaire">
            <div class="admin-score-ligne">
                <div>
                    <span class="admin-score-libelle">Score {{ match.team1 }}</span>
                    <input type="number" name="scoreTeam1" value="0" min="0" class="admin-score-champ">
                </div>
                <div>
                    <span class="admin-score-libelle">Score {{ match.team2 }}</span>
                    <input type="number" name="scoreTeam2" value="0" min="0" class="admin-score-champ">
                </div>
            </div>
            <button type="submit" class="admin-btn-valider">Valider le résultat</button>
        </form>
    </div>

    <a href="{{ path('admin_matchs_index') }}" class="admin-retour">← Retour à la liste</a>
</main>
{% endblock %}
