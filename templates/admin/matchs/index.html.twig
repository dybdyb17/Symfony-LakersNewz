{% extends 'base.html.twig' %}
{% block title %}Admin - Matchs{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body_class %}admin-page{% endblock %}
{% block body %}
<main class="admin-main">
    <div class="admin-header">
        <h1 class="admin-title">Gestion des matchs</h1>
        <a href="{{ path('admin_matchs_new') }}" class="admin-btn-new">+ Nouveau match</a>
    </div>

    {% include 'admin/_nav.html.twig' %}

    {% for message in app.flashes('success') %}
        <div class="admin-flash-success">{{ message }}</div>
    {% endfor %}

    <div class="admin-table-wrapper">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Équipe 1</th>
                    <th>Équipe 2</th>
                    <th class="center">Cotes</th>
                    <th class="center">Date</th>
                    <th class="center">Statut</th>
                    <th class="center">Score</th>
                    <th class="center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for match in matchs %}
                    <tr>
                        <td>{{ match.team1 }}</td>
                        <td>{{ match.team2 }}</td>
                        <td class="center">{{ match.cote1 }} / {{ match.cote2 }}</td>
                        <td class="center">{{ match.dateMatch ? match.dateMatch|date('d/m/Y H:i') : '—' }}</td>
                        <td class="center">
                            {% if match.statut == 'termine' %}
                                <span class="admin-badge admin-badge--green">Terminé</span>
                            {% elseif match.statut == 'en_cours' %}
                                <span class="admin-badge admin-badge--orange">En cours</span>
                            {% else %}
                                <span class="admin-badge admin-badge--blue">À venir</span>
                            {% endif %}
                        </td>
                        <td class="center">
                            {% if match.scoreTeam1 is not null %}
                                {{ match.scoreTeam1 }} - {{ match.scoreTeam2 }}
                            {% else %}
                                —
                            {% endif %}
                        </td>
                        <td class="center">
                            {% if match.statut != 'termine' %}
                                <a href="{{ path('admin_matchs_resultat', {id: match.id}) }}" class="admin-btn-resultat">Résultat</a>
                            {% endif %}
                            <form method="post" action="{{ path('admin_matchs_delete', {id: match.id}) }}" style="display: inline;" onsubmit="return confirm('Supprimer ce match ?');">
                                <button type="submit" class="admin-btn-delete">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="7" class="empty-row">Aucun match</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>
{% endblock %}
