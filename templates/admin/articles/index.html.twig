{% extends 'base.html.twig' %}
{% block title %}création d'article BY MEEEE{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/admin.css') }}">{% endblock %}
{% block body_class %}admin{% endblock %}
{% block body %}
<main class="admin-page">
    <div class="admin-haut">
        <h1 class="admin-titre">Gestion des articles</h1>
        <a href="{{ path('admin_articles_new') }}" class="admin-bouton-nouveau">+ nouvel article</a>
    </div>

    {% include 'admin/_nav.html.twig' %}

    {% for message in app.flashes('success') %}
        <div class="admin-succes">{{ message }}</div>
    {% endfor %}

    <div class="admin-tableauau-conteneur">
        <table class="admin-tableau">
            <thead>
                <tr>
                    <th>Titre</th>
                    <th class="center">Catégorie</th>
                    <th class="center">Auteur</th>
                    <th class="center">Date</th>
                    <th class="center">Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for article in articles %}
                    <tr>
                        <td>{{ article.titre }}</td>
                        <td class="center">{{ article.categorie ?? '—' }}</td>
                        <td class="center">{{ article.auteur ?? 'Lakers Newz' }}</td>
                        <td class="center">{{ article.createdAt ? article.createdAt|date('d/m/Y') : '—' }}</td>
                        <td class="center">
                            <a href="{{ path('admin_articles_edit', {id: article.id}) }}" class="admin-bouton-modifier">Modifier</a>
                            <form method="post" action="{{ path('admin_articles_delete', {id: article.id}) }}" class="form-inline" onsubmit="return confirm('Supprimer cet article ?');">
                                <button type="submit" class="admin-bouton-supprimer">Supprimer</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="5" class="empty">Aucun article</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</main>
{% endblock %}
