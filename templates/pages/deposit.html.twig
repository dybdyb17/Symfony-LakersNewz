<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Déposer - Lakers Newz</title>
    <link href="{{ asset('assets/fonts/fontawesome/css/fontawesome.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/brands.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/solid.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/solid.min.css') }}" rel="stylesheet">
    <link rel="shortcut icon" href="{{ asset('assets/icons/favicon.ico') }}" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Exo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/deposit.css') }}">
</head>
<body class="deposer-page">
    <div class="deposer-bg-pattern"></div>

    <header class="deposer-header">
        <button class="deposer-close-btn" onclick="window.location.href='{{ path('app_paris') }}'"><i class="fa-solid fa-xmark"></i></button>
        <div class="deposer-header-right">
            <span class="deposer-solde-badge">
                <i class="fa-solid fa-plus"></i>
                <span>{{ solde|number_format(2, ',', ' ') }} €</span>
            </span>
        </div>
    </header>

    <main class="deposer-main">
        <h1 class="deposer-titre">Déposer</h1>

        {% if success %}
            <div class="deposer-confirm-overlay" style="display:flex;">
                <div class="deposer-confirm-box">
                    <div class="confirm-check"><i class="fa-solid fa-circle-check"></i></div>
                    <p class="confirm-titre">Dépôt confirmé</p>
                    <p class="confirm-sous">Montant du Dépôt</p>
                    <p class="confirm-montant">{{ montant|number_format(2, ',', ' ') }} €</p>
                    <a href="{{ path('app_paris') }}" class="confirm-ok-btn" style="display:block; text-align:center; text-decoration:none;">OK</a>
                </div>
            </div>
        {% endif %}

        {% for message in app.flashes('error') %}
            <div style="background: #e53935; color: white; padding: 12px; border-radius: 8px; margin-bottom: 15px; text-align: center; font-weight: 600;">
                {{ message }}
            </div>
        {% endfor %}

        <form method="post" action="{{ path('app_deposer') }}">
            <div class="deposer-bloc">
                <div class="deposer-amount-row">
                    <input type="number" id="montantInput" name="montant" value="0" min="0" max="5000">
                    <span class="deposer-currency">€</span>
                </div>
                <div class="deposer-presets">
                    <button type="button" class="dep-preset" data-amount="10">10 €</button>
                    <button type="button" class="dep-preset" data-amount="20">20 €</button>
                    <button type="button" class="dep-preset" data-amount="50">50 €</button>
                    <button type="button" class="dep-preset" data-amount="100">100 €</button>
                </div>
                <p class="deposer-limite">Tu peux encore déposer jusqu'à <strong>5000 €</strong></p>
            </div>

            <div class="deposer-paiement-bloc">
                <p class="deposer-paiement-label">Moyen de paiement</p>
                <div class="deposer-carte-option">
                    <div class="carte-option-top">
                        <span class="carte-option-label">Carte bancaire</span>
                        <div class="carte-logos">
                            <i class="fa-brands fa-cc-visa"></i>
                            <i class="fa-brands fa-cc-mastercard"></i>
                        </div>
                    </div>
                    <div class="carte-option-limits">
                        <span>min 11 €</span>
                        <span>Max 50 000 €</span>
                    </div>
                </div>
            </div>

            <button type="submit" class="deposer-continuer-btn">Continuer</button>
            <p class="deposer-securise"><i class="fa-solid fa-lock"></i> Paiement sécurisé</p>
        </form>
    </main>

    <script>
    document.querySelectorAll('.dep-preset').forEach(btn => {
        btn.addEventListener('click', () => {
            document.getElementById('montantInput').value = btn.dataset.amount;
        });
    });
    </script>
</body>
</html>
