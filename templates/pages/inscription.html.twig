{% extends 'base.html.twig' %}
{% block title %}S'inscrire - Lakers Newz{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/auth.css') }}">{% endblock %}
{% block body_class %}page-auth inscription-page{% endblock %}
{% block body %}
<main class="auth-principal">
    <div class="auth-left">
        {% if success %}
            <div class="succes-carte show">
                <div class="succes-icone"><i class="fa-solid fa-check"></i></div>
                <h2 style="color: #4CAF50;">Compte créé avec succès</h2>
                <p>Bienvenue {{ prenom }}</p>
                <a href="{{ path('app_connexion') }}" class="auth-bouton succes-bouton">Se connecter</a>
            </div>
        {% else %}
            <div class="auth-carte">
                <div class="auth-entete">
                    <h1>S'inscrire</h1>
                    <p>Créer votre compte</p>
                </div>

                {{ form_start(registrationForm, {'attr': {'class': 'auth-formulaire'}}) }}

                    <div class="formulaire-groupe">
                        {{ form_label(registrationForm.firstname) }}
                        {{ form_widget(registrationForm.firstname) }}
                        {{ form_errors(registrationForm.firstname) }}
                    </div>

                    <div class="formulaire-groupe">
                        {{ form_label(registrationForm.lastname) }}
                        {{ form_widget(registrationForm.lastname) }}
                        {{ form_errors(registrationForm.lastname) }}
                    </div>

                    <div class="formulaire-groupe">
                        {{ form_label(registrationForm.pseudo) }}
                        {{ form_widget(registrationForm.pseudo) }}
                        {{ form_errors(registrationForm.pseudo) }}
                    </div>

                    <div class="formulaire-groupe">
                        {{ form_label(registrationForm.email) }}
                        {{ form_widget(registrationForm.email) }}
                        {{ form_errors(registrationForm.email) }}
                    </div>

                    <div class="formulaire-groupe">
                        {{ form_label(registrationForm.dateNaissance) }}
                        {{ form_widget(registrationForm.dateNaissance) }}
                        {{ form_errors(registrationForm.dateNaissance) }}
                    </div>

                    <div class="formulaire-groupe">
                        {{ form_label(registrationForm.telephone) }}
                        {{ form_widget(registrationForm.telephone) }}
                        {{ form_errors(registrationForm.telephone) }}
                    </div>

                    <div class="formulaire-groupe">
                        {{ form_label(registrationForm.lieuNaissance) }}
                        {{ form_widget(registrationForm.lieuNaissance) }}
                        {{ form_errors(registrationForm.lieuNaissance) }}
                    </div>

                    <div class="formulaire-groupe">
                        {{ form_label(registrationForm.plainPassword.first) }}
                        {{ form_widget(registrationForm.plainPassword.first) }}
                        {{ form_errors(registrationForm.plainPassword.first) }}
                    </div>

                    <div class="formulaire-groupe">
                        {{ form_label(registrationForm.plainPassword.second) }}
                        {{ form_widget(registrationForm.plainPassword.second) }}
                        {{ form_errors(registrationForm.plainPassword.second) }}
                    </div>

                    <div class="formulaire-cases">
                        <label>
                            {{ form_widget(registrationForm.age18) }}
                            Je certifie avoir 18 ans ou plus
                        </label>
                        {{ form_errors(registrationForm.age18) }}
                        <label>
                            {{ form_widget(registrationForm.agreeTerms) }}
                            J'accepte les conditions d'utilisation
                        </label>
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>

                    <button type="submit" class="auth-bouton">S'inscrire</button>

                {{ form_end(registrationForm) }}

                <div class="auth-pied">
                    <p>Avez vous un compte? <a href="{{ path('app_connexion') }}">Se connecter</a></p>
                </div>
            </div>
        {% endif %}
    </div>
    <div class="auth-right">
        <img src="{{ asset('assets/img/dean-bennett-nFjLHE4vmn4-unsplash.jpg') }}" alt="Kobe Bryant Mural" class="auth-image">
    </div>
</main>
{% endblock %}
