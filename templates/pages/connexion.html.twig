{% extends 'base.html.twig' %}
{% block title %}Se connecter - Lakers Newz{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/auth.css') }}">{% endblock %}
{% block body_class %}page-auth connexion-page{% endblock %}
{% block body %}
<main class="auth-principal">
    <div class="auth-left">
        <div class="auth-carte connexion-carte">
            <div class="auth-entete">
                <h1>Se connecter</h1>
                <p>Entre ton adresse mail et mot de passe</p>
            </div>

            {% if error %}
                <div class="flash-erreur">Email ou mot de passe incorrect</div>
            {% endif %}

            <form class="auth-formulaire" method="post" action="{{ path('app_connexion') }}">
                <div class="formulaire-groupe">
                    <label for="email">Adresse e-mail</label>
                    <input type="email" id="email" name="email" value="{{ last_username }}" placeholder="Entre ton adresse mail" required>
                </div>
                <div class="formulaire-groupe">
                    <div class="libelle-ligne">
                        <label for="password">Mot de passe</label>
                        <a href="#" class="mdp-oublie">mot de passe oublié?</a>
                    </div>
                    <div class="mdp-conteneur">
                        <input type="password" id="password" name="password" placeholder="••••••••••" required>
                        <button type="button" class="bouton-voir-mdp"><i class="fa-solid fa-eye-slash"></i></button>
                    </div>
                </div>
                <div class="formulaire-cases">
                    <label>
                        <input type="checkbox" id="remember" name="_remember_me">
                        Me souvenir
                    </label>
                </div>
                <button type="submit" class="auth-bouton">Se connecter</button>
            </form>
            <div class="auth-pied">
                <p>Pas de compte ? <a href="{{ path('app_inscription') }}">Inscris toi</a></p>
            </div>
        </div>
    </div>
    <div class="auth-right">
        <img src="{{ asset('assets/img/dean-bennett-nFjLHE4vmn4-unsplash.jpg') }}" alt="Kobe Bryant " class="auth-image">
    </div>
</main>
{% endblock %}
{% block javascripts %}
<script src="{{ asset('js/connexion.js') }}"></script>
{% endblock %}
