{% extends 'base.html.twig' %}
{% block title %}Se connecter - Lakers Newz{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/auth.css') }}">{% endblock %}
{% block body_class %}auth-page connexion-page{% endblock %}
{% block body %}
<main class="auth-main">
    <div class="auth-left">
        <div class="auth-card connexion-card">
            <div class="auth-header">
                <h1>Se connecter</h1>
                <p>Entre ton adresse mail et mot de passe</p>
            </div>
            <form class="auth-form" id="connexionForm">
                <div class="form-group">
                    <label for="email">Adresse e-mail</label>
                    <input type="email" id="email" name="email" placeholder="Entre ton adresse mail" required>
                </div>
                <div class="form-group">
                    <div class="label-row">
                        <label for="password">Mot de passe</label>
                        <a href="#" class="forgot-password">mot de passe oublié?</a>
                    </div>
                    <div class="password-wrapper">
                        <input type="password" id="password" name="password" placeholder="••••••••••" required>
                        <button type="button" class="toggle-password"><i class="fa-solid fa-eye-slash"></i></button>
                    </div>
                </div>
                <div class="form-checkboxes">
                    <label class="checkbox-wrapper">
                        <input type="checkbox" id="remember" name="remember">
                        <span class="checkmark"></span>
                        <span class="checkbox-label">Me souvenir</span>
                    </label>
                </div>
                <button type="submit" class="auth-btn">Se connecter</button>
            </form>
            <div class="auth-footer">
                <p>Pas de compte ? <a href="{{ path('app_register') }}">Inscris toi</a></p>
            </div>
        </div>
    </div>
    <div class="auth-right">
        <img src="{{ asset('assets/img/dean-bennett-nFjLHE4vmn4-unsplash.jpg') }}" alt="Kobe Bryant Mural" class="auth-image">
    </div>
</main>
{% endblock %}
{% block javascripts %}<script src="{{ asset('js/auth.js') }}"></script>{% endblock %}
