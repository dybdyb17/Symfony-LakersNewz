{% extends 'base.html.twig' %}
{% block title %}Contact - Lakers Newz{% endblock %}
{% block stylesheets %}<link rel="stylesheet" href="{{ asset('css/contact.css') }}">{% endblock %}
{% block body_class %}contact-page{% endblock %}
{% block body %}
<main class="contact-main">
    <div class="contact-container">
        <div class="contact-header">
            <div class="contact-icon"><i class="fa-solid fa-envelope"></i></div>
            <h1>Contacte moi</h1>
        </div>
        <div class="contact-form-card">
            <h2>Formulaire de contact</h2>

            {% if success %}
                <div class="form-success show">
                    <div class="success-icon"><i class="fa-solid fa-circle-check"></i></div>
                    <p>Merci ! Votre message a été envoyé avec succès.</p>
                    <a href="{{ path('app_home') }}" class="btn-back-home">Retourner à la page d'accueil</a>
                </div>
            {% else %}
                {% if error %}
                    <div style="background: #e53935; color: white; padding: 12px; border-radius: 8px; margin-bottom: 15px; text-align: center; font-weight: 600;">
                        {{ error }}
                    </div>
                {% endif %}

                <form class="contact-form" method="post" action="{{ path('app_contact') }}">
                    <div class="form-group">
                        <input type="text" id="name" name="name" placeholder="entre ton nom" required>
                    </div>
                    <div class="form-group">
                        <input type="email" id="email" name="email" placeholder="email" required>
                    </div>
                    <div class="form-group">
                        <select id="subject" name="subject" required>
                            <option value="" disabled selected>choisir un sujet</option>
                            <option value="question">Question générale</option>
                            <option value="suggestion">Suggestion</option>
                            <option value="bug">Signaler un bug</option>
                            <option value="partenariat">Partenariat</option>
                            <option value="autre">Autre</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <textarea id="message" name="message" rows="5" placeholder="message" required></textarea>
                    </div>
                    <button type="submit" class="submit-btn">
                        <i class="fa-solid fa-paper-plane"></i> Envoyer le message
                    </button>
                </form>
            {% endif %}
        </div>
        <div class="contact-info-card">
            <h2>Informations</h2>
            <div class="info-item">
                <div class="info-icon"><i class="fa-solid fa-envelope"></i></div>
                <div class="info-content"><h3>email</h3><p>dybrilboudiaf14@gmail.com</p></div>
            </div>
            <div class="info-item">
                <div class="info-icon"><i class="fa-solid fa-phone"></i></div>
                <div class="info-content"><h3>Téléphone</h3><p>0627962735</p></div>
            </div>
            <div class="info-item">
                <div class="info-icon"><i class="fa-solid fa-location-dot"></i></div>
                <div class="info-content"><h3>Adresse</h3><p>62 avenue du merlan<br>13014 Marseille, France</p></div>
            </div>
            <div class="social-section">
                <h3>Suis moi</h3>
                <div class="social-icons">
                    <a href="#" class="social-icon"><i class="fa-brands fa-x-twitter"></i></a>
                    <a href="#" class="social-icon"><i class="fa-brands fa-youtube"></i></a>
                    <a href="#" class="social-icon"><i class="fa-brands fa-instagram"></i></a>
                    <a href="#" class="social-icon"><i class="fa-brands fa-facebook-f"></i></a>
                </div>
            </div>
        </div>
    </div>
</main>
{% endblock %}
{% block javascripts %}{% endblock %}
