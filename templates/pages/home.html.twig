{% extends 'base.html.twig' %}

{% block title %}Lakers Newz - Actu des Los Angeles Lakers{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/home.css') }}">
{% endblock %}

{% block body_class %}page-accueil{% endblock %}

{% block body %}
<div class="img"></div>
<main class="accueil-principal">
    <section class="bandeau-section">
        <div class="bandeau-contenu">
            <h1 class="bandeau-titre">
                <span class="bandeau-sous-titre">Bienvenue sur</span>
                Lakers Newz
            </h1>
            <p class="bandeau-description">
                Toute l'actualité des Los Angeles Lakers en temps réel
            </p>
            <a href="#actualites-section" class="bandeau-bouton">
                <i class="fa-solid fa-arrow-down"></i>
                Découvrir les news
            </a>
        </div>
    </section>

    <section id="actualites-section" class="actualites-section">
        <div class="actualites-conteneur">
            <div class="actualites-entete">
                <h2><i class="fa-solid fa-newspaper"></i> Dernières actualités</h2>
                <p>Restez informé des dernières nouvelles des Lakers</p>
            </div>

            <div class="actualites-grille">
                {% if articles is empty %}
                    <div>
                        <p>Aucun article pour le moment</p>
                    </div>
                {% else %}
                    {% for article in articles %}
                        <article class="actualite-carte">
                            <div class="actualite-carte-image">
                                <img src="{{ article.image ?? 'https://images.unsplash.com/photo-1546519638-68e109498ffc?w=800&h=600&fit=crop' }}" alt="{{ article.titre }}" loading="lazy">
                                <span class="news-category {% if article.categorie == 'rumeurs' %}category-rumeurs
                                {% elseif article.categorie == 'interviews' %}category-interviews
                                {% elseif article.categorie == 'analyses' %}category-analyses
                                {% endif %}">{{ article.categorie|default('News')|capitalize }}
                                </span>
                            </div>
                            <div class="actualite-carte-contenu">
                                <div class="actualite-carte-date">
                                    <i class="fa-solid fa-calendar"></i>
                                    {{ article.createdAt|date('d F Y') }}
                                </div>
                                <h3 class="actualite-carte-titre">{{ article.titre }}</h3>
                                <p class="actualite-carte-extrait">{{ article.contenu|length > 150 ? article.contenu|slice(0, 150) ~ '...' : article.contenu }}</p>
                                <div class="actualite-carte-pied">
                                    <span class="actualite-carte-auteur">
                                        <i class="fa-solid fa-user"></i>
                                        {{ article.auteur|default('Lakers Newz') }}
                                    </span>
                                    <a href="#" class="actualite-carte-lire-plus">
                                        Lire la suite
                                        <i class="fa-solid fa-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </article>
                    {% endfor %}
                {% endif %}
            </div>
        </div>
    </section>
</main>
{% endblock %}
