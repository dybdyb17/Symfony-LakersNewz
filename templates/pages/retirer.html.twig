<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Retirer - Lakers Newz</title>
    <link href="{{ asset('assets/fonts/fontawesome/css/fontawesome.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/brands.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/solid.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/solid.min.css') }}" rel="stylesheet">
    <link rel="shortcut icon" href="{{ asset('assets/icons/favicon.ico') }}" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Exo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/deposer.css') }}">
    <link rel="stylesheet" href="{{ asset('css/retirer.css') }}">
</head>
<body class="deposer-page retirer-page">
    <div class="deposer-bg-pattern"></div>

    <header class="deposer-header">
        <button class="deposer-btn-fermer" onclick="window.location.href='{{ path('app_paris') }}'"><i class="fa-solid fa-xmark"></i></button>
        <div class="deposer-header-right">
            <span class="deposer-solde-badge">
                <i class="fa-solid fa-plus"></i>
                <span>{{ solde|number_format(2, ',', ' ') }} €</span>
            </span>
        </div>
    </header>

    <main class="deposer-principal">
        <h1 class="deposer-title">Retirer</h1>

        {% if success %}
            <div class="deposer-confirmation-fond visible">
                <div class="deposer-confirmation-boite">
                    <div class="confirm-check"><i class="fa-solid fa-circle-check"></i></div>
                    <p class="confirm-title">Retrait confirmé</p>
                    <p class="confirm-sous">Montant du retrait</p>
                    <p class="confirm-montant">{{ montant|number_format(2, ',', ' ') }} €</p>
                    <a href="{{ path('app_paris') }}" class="confirm-ok-btn confirm-ok-lien">OK</a>
                </div>
            </div>
        {% endif %}

        {% if insuffisant %}
            <div class="deposer-confirmation-fond visible">
                <div class="deposer-confirmation-boite">
                    <div class="retirer-icon-error">⚔️</div>
                    <p class="confirm-title retirer-title-error">Solde insuffisant</p>
                    <p class="confirm-sous retirer-sous-error">Pour retirer de l'argent, votre solde doit être supérieur à 10€</p>
                    <a href="{{ path('app_retirer') }}" class="confirm-ok-btn retirer-ok-btn confirm-ok-lien">OK</a>
                </div>
            </div>
        {% endif %}

        {% for message in app.flashes('error') %}
            <div class="flash-erreur">{{ message }}</div>
        {% endfor %}

        <form method="post" action="{{ path('app_retirer') }}">
            <div class="deposer-bloc">
                <div class="deposer-montant-ligne">
                    <input type="number" id="montantInput" name="montant" value="0" min="0">
                    <span class="deposer-devise">€</span>
                </div>
                <div class="deposer-valeurs-rapides">
                    <button type="button" class="dep-valeur" data-amount="10">10 €</button>
                    <button type="button" class="dep-valeur" data-amount="20">20 €</button>
                    <button type="button" class="dep-valeur" data-amount="50">50 €</button>
                    <button type="button" class="dep-valeur" data-amount="100">100 €</button>
                </div>
                <p class="deposer-limite">Minimum de retrait : <strong>10 €</strong></p>
            </div>

            <div class="deposer-paiement-bloc">
                <p class="deposer-paiement-libelle">Moyen de retrait</p>
                <div class="deposer-card-option">
                    <div class="card-option-haut">
                        <span class="card-option-libelle">Carte bancaire</span>
                        <div class="card-logos">
                            <i class="fa-brands fa-cc-visa"></i>
                            <i class="fa-brands fa-cc-mastercard"></i>
                        </div>
                    </div>
                    <div class="card-option-limites">
                        <span>min 10 €</span>
                        <span>Max 50 000 €</span>
                    </div>
                </div>
            </div>

            <button type="submit" class="deposer-continuer-btn">Retirer</button>
            <p class="deposer-securise"><i class="fa-solid fa-lock"></i> Transaction sécurisée</p>
        </form>
    </main>

    <script src="{{ asset('js/retirer.js') }}"></script>
</body>
</html>
