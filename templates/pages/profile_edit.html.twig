<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modifier mon profil - Lakers Newz</title>
    <link href="{{ asset('assets/fonts/fontawesome/css/fontawesome.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/brands.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/solid.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/solid.min.css') }}" rel="stylesheet">
    <link rel="shortcut icon" href="{{ asset('assets/icons/favicon.ico') }}" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Exo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/profile.css') }}">
</head>
<body class="profil-page">
    <div class="profil-bg-pattern"></div>

    <div class="profil-view">
        <header class="profil-header">
            <h1 class="profil-header-titre">Modifier mes informations</h1>
            <button class="profil-back-btn" onclick="window.location.href='{{ path('app_profil') }}'"><i class="fa-solid fa-chevron-left"></i></button>
        </header>

        {{ form_start(profilForm, {'attr': {'class': 'info-section'}}) }}

            <div class="info-section">
                <h2 class="info-section-titre">Mon identité</h2>
                <div class="info-table">
                    <div class="info-row">
                        <span class="info-label">{{ form_label(profilForm.lastname) }}</span>
                        {{ form_widget(profilForm.lastname, {'attr': {'class': 'info-edit-input'}}) }}
                    </div>
                    <div class="info-row">
                        <span class="info-label">{{ form_label(profilForm.firstname) }}</span>
                        {{ form_widget(profilForm.firstname, {'attr': {'class': 'info-edit-input'}}) }}
                    </div>
                    <div class="info-row">
                        <span class="info-label">{{ form_label(profilForm.pseudo) }}</span>
                        {{ form_widget(profilForm.pseudo, {'attr': {'class': 'info-edit-input'}}) }}
                    </div>
                    <div class="info-row">
                        <span class="info-label">{{ form_label(profilForm.dateNaissance) }}</span>
                        {{ form_widget(profilForm.dateNaissance, {'attr': {'class': 'info-edit-input'}}) }}
                    </div>
                    <div class="info-row">
                        <span class="info-label">{{ form_label(profilForm.lieuNaissance) }}</span>
                        {{ form_widget(profilForm.lieuNaissance, {'attr': {'class': 'info-edit-input'}}) }}
                    </div>
                </div>
            </div>

            <div class="info-section">
                <h2 class="info-section-titre">Mes informations de contact</h2>
                <div class="info-table">
                    <div class="info-row">
                        <span class="info-label">{{ form_label(profilForm.email) }}</span>
                        {{ form_widget(profilForm.email, {'attr': {'class': 'info-edit-input'}}) }}
                    </div>
                    <div class="info-row">
                        <span class="info-label">{{ form_label(profilForm.telephone) }}</span>
                        {{ form_widget(profilForm.telephone, {'attr': {'class': 'info-edit-input'}}) }}
                    </div>
                </div>
            </div>

            <button type="submit" class="profil-info-btn">
                <i class="fa-solid fa-floppy-disk"></i> Enregistrer
            </button>

        {{ form_end(profilForm) }}
    </div>
</body>
</html>
