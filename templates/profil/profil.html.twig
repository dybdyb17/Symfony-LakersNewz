<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profil - Lakers Newz</title>
    <link href="{{ asset('assets/fonts/fontawesome/css/fontawesome.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/brands.min.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/solid.css') }}" rel="stylesheet">
    <link href="{{ asset('assets/fonts/fontawesome/css/solid.min.css') }}" rel="stylesheet">
    <link rel="shortcut icon" href="{{ asset('assets/icons/favicon.ico') }}" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Exo:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('css/profil.css') }}">
</head>
<body class="profil-page">
    <div class="profil-fond-motif"></div>

    <div class="profil-vue" id="profilView">
        <header class="profil-header">
            <h1 class="profil-header-title">Profil</h1>
            <button class="profil-btn-fermer" onclick="window.location.href='{{ path('app_paris') }}'"><i class="fa-solid fa-xmark"></i></button>
        </header>

        <div class="profil-bandeau">
            <div class="profil-avatar-conteneur">
                <div class="profil-avatar">
                    {% set initiales = (user.firstname|default('')|first ~ user.lastname|default('')|first)|upper %}
                    {% if initiales is not empty %}
                        {{ initiales }}
                    {% else %}
                        <i class="fa-solid fa-user"></i>
                    {% endif %}
                </div>
            </div>
            <div class="profil-identite">
                <p class="profil-pseudo">{{ user.pseudo ?? 'Utilisateur' }}</p>
            </div>
            <div class="profil-solde-conteneur">
                <p class="profil-solde-libelle">Solde disponible</p>
                <p class="profil-solde-montant">{{ user.solde|number_format(2, ',', ' ') }} €</p>
            </div>
        </div>

        <hr class="profil-separateur">

        {% for message in app.flashes('success') %}
            <div class="flash-succes">{{ message }}</div>
        {% endfor %}

        <div class="profil-actions">
            <a href="{{ path('app_deposer') }}" class="profil-action-card">
                <i class="fa-solid fa-money-bill-transfer"></i>
                <span>Déposer</span>
            </a>
            <a href="{{ path('app_retirer') }}" class="profil-action-card">
                <i class="fa-solid fa-money-bill-transfer"></i>
                <span>Retirer</span>
            </a>
        </div>

        <button class="profil-info-btn" onclick="document.getElementById('profilView').style.display='none'; document.getElementById('infoPersoView').style.display='block';">
            <i class="fa-solid fa-circle-user"></i> Info personnelle
        </button>

        <a href="{{ path('app_deconnexion') }}" class="profil-deconnexion-btn">Se déconnecter</a>
    </div>

    <div class="profil-vue profil-vue-cachee" id="infoPersoView">
        <header class="profil-header">
            <h1 class="profil-header-title">Info perso</h1>
            <button class="profil-btn-retour" onclick="document.getElementById('infoPersoView').style.display='none'; document.getElementById('profilView').style.display='block';"><i class="fa-solid fa-chevron-left"></i></button>
        </header>

        <!-- MODE LECTURE -->
        <div id="modeLecture">
            <div class="info-zone">
                <h2 class="info-zone-title">Mon identité</h2>
                <div class="info-table">
                    <div class="info-ligne">
                        <span class="info-libelle">Civilité</span>
                        <span class="info-valeur">Monsieur</span>
                    </div>
                    <div class="info-ligne">
                        <span class="info-libelle">Nom</span>
                        <span class="info-valeur">{{ user.lastname ?? '—' }}</span>
                    </div>
                    <div class="info-ligne">
                        <span class="info-libelle">Prénom</span>
                        <span class="info-valeur">{{ user.firstname ?? '—' }}</span>
                    </div>
                    <div class="info-ligne">
                        <span class="info-libelle">Pseudo</span>
                        <span class="info-valeur">{{ user.pseudo ?? '—' }}</span>
                    </div>
                    <div class="info-ligne">
                        <span class="info-libelle">Date de naissance</span>
                        <span class="info-valeur">{{ user.dateNaissance ? user.dateNaissance|date('d/m/Y') : '—' }}</span>
                    </div>
                    <div class="info-ligne">
                        <span class="info-libelle">Lieu de naissance</span>
                        <span class="info-valeur">{{ user.lieuNaissance ?? '—' }}</span>
                    </div>
                </div>
            </div>

            <div class="info-zone">
                <h2 class="info-zone-title">Mes informations de contact</h2>
                <div class="info-table">
                    <div class="info-ligne">
                        <span class="info-libelle">Email</span>
                        <span class="info-valeur">{{ user.email ?? '—' }}</span>
                    </div>
                    <div class="info-ligne">
                        <span class="info-libelle">Téléphone</span>
                        <span class="info-valeur">{{ user.telephone ?? '—' }}</span>
                    </div>
                </div>
            </div>

            <a href="{{ path('app_profil_modifier') }}" class="profil-info-btn">Modifier mes informations</a>

            <form method="post" action="{{ path('app_profil_supprimer') }}" onsubmit="return confirm('Êtes-vous sûr de vouloir clôturer votre compte ? Cette action est irréversible.');">
                <button type="submit" class="profil-cloture-btn">Clôturer mon compte</button>
            </form>
        </div>

    </div>
</body>
</html>
