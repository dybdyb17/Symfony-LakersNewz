<header class="navbar">
    <div class="nav-liens">
        <a href="https://www.ticketmaster.com/los-angeles-lakers-tickets/artist/805962" class="btn btn-or">Billeterie</a>
        <a href="https://www.nbastore.eu/fr/los-angeles-lakers/t-25031846+z-9030758-2040509788" class="btn btn-violet">#Boutique</a>
        <a href="https://www.youtube.com/c/LakeShowHighlights" class="btn btn-noir">#Lakeshow</a>
    </div>

    <div class="nav-logo">
        <a href="{{ path('app_accueil') }}">
            <img src="{{ asset('assets/img/logo_LakersNewz.png') }}" width="130" height="40" alt="Lakers Newz">
        </a>
    </div>

    <div class="nav-actions">
        <button class="btn-recherche" aria-label="Rechercher">
            <i class="fa-solid fa-magnifying-glass"></i>
        </button>

        <div class="settings-menu">
            <button class="btn-settings" aria-label="Réglages">
                <i class="fa-solid fa-gear"></i>
            </button>

            <div class="sous-menu">
                {% if app.user %}
                    <div class="sous-menu-element statut-utilisateur">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Vous êtes connecté</span>
                    </div>
                    {% if is_granted('ROLE_ADMIN') %}
                        <a href="{{ path('admin_matchs_index') }}" class="sous-menu-element">
                            <i class="fa-solid fa-shield"></i>
                            <span>Admin</span>
                        </a>
                        <div class="sous-menu-separateur"></div>
                    {% endif %}
                    <a href="{{ path('app_deconnexion') }}" class="sous-menu-element">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <span>Se déconnecter</span>
                    </a>
                {% else %}
                    <a href="{{ path('app_inscription') }}" class="sous-menu-element">
                        <i class="fa-solid fa-user-plus"></i>
                        <span>S'inscrire</span>
                    </a>
                    <a href="{{ path('app_connexion') }}" class="sous-menu-element">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        <span>Se connecter</span>
                    </a>
                {% endif %}
                <div class="sous-menu-separateur"></div>
                <a href="{{ path('app_contact') }}" class="sous-menu-element">
                    <i class="fa-solid fa-envelope"></i>
                    <span>Contact</span>
                </a>
            </div>
        </div>
    </div>
</header>
